          <mxGeometry x="500" y="90" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="10" target="11">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <!-- ========== PREPROCESSING ========== -->
        <mxCell id="11" value="&lt;b&gt;Preprocessing&lt;/b&gt;&lt;hr&gt;Resize(224x224)&lt;br&gt;ToTensor + Normalize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAEEF3;strokeColor=#2980B9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="180" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <!-- ========== FEATURE EXTRACTION ========== -->
        <mxCell id="12" value="&lt;b&gt;Feature Extraction&lt;/b&gt;&lt;hr&gt;ResNet-50 + MoCo v2&lt;br&gt;Layer1+2+3, Concat &lt;b&gt;[1792,56,56]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAEEF3;strokeColor=#2980B9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="270" width="200" height="65" as="geometry" />
        </mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="12" target="13">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <!-- ========== DIM REDUCTION + RESHAPE ========== -->
        <mxCell id="13" value="&lt;b&gt;Dim Reduction &amp;amp; Reshape&lt;/b&gt;&lt;hr&gt;1792 jadi 550 via dim_indices.pt&lt;br&gt;Flatten &lt;b&gt;[1, 3136, 550]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAEEF3;strokeColor=#2980B9;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="370" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="13" target="14">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <!-- ========== OOD DETECTION (DIAMOND) ========== -->
        <mxCell id="14" value="&lt;b&gt;OOD Detection&lt;/b&gt;&lt;hr&gt;&lt;b&gt;ComboOOD&lt;/b&gt;&lt;br&gt;mc = -1/2 * mean(MD^2)&lt;br&gt;kc = -sqrt(550) * log(KNN 1-NN)&lt;br&gt;combo = kc + mc&amp;ensp;&amp;gt;=&amp;ensp;0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#F1C40F;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="515" y="470" width="170" height="100" as="geometry" />
        </mxCell>

        <!-- OOD ke YA (down) -->
        <mxCell id="e14ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#27AE60;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="14" target="16">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <!-- OOD ke TIDAK (right) -->
        <mxCell id="e14no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E74C3C;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="14" target="15">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <!-- NON-BOTTLE REJECT -->
        <mxCell id="15" value="&lt;b&gt;NON-BOTTLE: DITOLAK&lt;/b&gt;&lt;hr&gt;Gambar tidak diproses&lt;br&gt;(Dashboard menampilkan warning)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="770" y="495" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- ========== SPLIT ========== -->
        <mxCell id="16" value="&lt;b&gt;SPLIT&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#F1C40F;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="620" width="80" height="35" as="geometry" />
        </mxCell>

        <!-- Split ke PaDiM -->
        <mxCell id="e16l" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8E44AD;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="16" target="17">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="270" y="637" />
            </Array>
            </mxGeometry>
        </mxCell>

        <!-- Split ke KNN -->
        <mxCell id="e16r" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E86C1;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="16" target="18">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="637" />
            </Array>
            </mxGeometry>
        </mxCell>

        <!-- ========== PaDiM PATH (LEFT) ========== -->
        <mxCell id="17" value="&lt;b&gt;PaDiM PATH — Mahalanobis Distance&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECF7;strokeColor=#8E44AD;dashed=1;fontSize=12;fontColor=#6C3483;" vertex="1" parent="1">
          <mxGeometry x="50" y="680" width="440" height="380" as="geometry" />
        </mxCell>

        <mxCell id="17a" value="&lt;b&gt;1. Mahalanobis Distance per Patch&lt;/b&gt;&lt;hr&gt;D^2(p) = (p - mu)^T * S^(-1) * (p - mu)&lt;br&gt;untuk setiap patch [550], hasil 3.136 nilai D^2&lt;br&gt;&lt;i&gt;compute_patch_scores() via torch.bmm&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#8E44AD;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="700" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e17a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8E44AD;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="17a" target="17b">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <mxCell id="17b" value="&lt;b&gt;2. Gaussian Blur sigma=4 (pada 56x56)&lt;/b&gt;&lt;hr&gt;Blur pada grid asli 56x56 (sebelum upsample)&lt;br&gt;Kernel 9x9 untuk mengurangi noise per-patch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#8E44AD;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="785" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e17b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8E44AD;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="17b" target="17c">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <mxCell id="17c" value="&lt;b&gt;3. Upsample (Bilinear) 56x56 menjadi 224x224&lt;/b&gt;&lt;hr&gt;Skala ke resolusi pixel asli&lt;br&gt;&lt;i&gt;F.interpolate(mode='bilinear')&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#8E44AD;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="865" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e17c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8E44AD;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="17c" target="17d">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <mxCell id="17d" value="&lt;b&gt;4. Image-Level Score (Max Pooling)&lt;/b&gt;&lt;hr&gt;Ambil nilai maksimum dari seluruh pixel [224,224]&lt;br&gt;menghasilkan satu skalar: &lt;b&gt;skor PaDiM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#8E44AD;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="945" width="400" height="55" as="geometry" />
        </mxCell>

        <!-- ========== KNN PATH (RIGHT) ========== -->
        <mxCell id="18" value="&lt;b&gt;KNN PATH — Euclidean Distance (K=5)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2E86C1;dashed=1;fontSize=12;fontColor=#1A5276;" vertex="1" parent="1">
          <mxGeometry x="710" y="680" width="440" height="380" as="geometry" />
        </mxCell>

        <mxCell id="18a" value="&lt;b&gt;1. Euclidean Distance ke Feature Bank&lt;/b&gt;&lt;hr&gt;Cari 5 nearest neighbors dari bank [655424, 550]&lt;br&gt;Rata-rata jarak, menghasilkan D^2 per patch [3136]&lt;br&gt;&lt;i&gt;compute_knn_anomaly_score() chunked (22 chunks)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E6F1;strokeColor=#2E86C1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="700" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e18a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E86C1;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="18a" target="18b">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <mxCell id="18b" value="&lt;b&gt;2. Reshape ke Grid 56x56&lt;/b&gt;&lt;hr&gt;3.136 nilai D^2 di-reshape menjadi [56, 56]&lt;br&gt;Kembali ke format spasial 2 dimensi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E6F1;strokeColor=#2E86C1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="785" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e18b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E86C1;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="18b" target="18c">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <mxCell id="18c" value="&lt;b&gt;3. Upsample (Bilinear) 56x56 menjadi 224x224&lt;/b&gt;&lt;hr&gt;Skala ke resolusi pixel asli&lt;br&gt;&lt;i&gt;F.interpolate(mode='bilinear')&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E6F1;strokeColor=#2E86C1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="865" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e18c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E86C1;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="18c" target="18d">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <mxCell id="18d" value="&lt;b&gt;4. Image-Level Score (Max Pooling)&lt;/b&gt;&lt;hr&gt;Ambil nilai maksimum dari seluruh pixel [224,224]&lt;br&gt;menghasilkan satu skalar: &lt;b&gt;skor KNN&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E6F1;strokeColor=#2E86C1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="945" width="400" height="55" as="geometry" />
        </mxCell>

        <!-- ========== CONVERGENCE ========== -->

        <!-- Arrow PaDiM ke Convergence -->
        <mxCell id="e17conv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8E44AD;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="17" target="19">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="270" y="1090" />
            </Array>
            </mxGeometry>
        </mxCell>

        <!-- Arrow KNN ke Convergence -->
        <mxCell id="e18conv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E86C1;strokeWidth=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="18" target="19">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="1090" />
            </Array>
            </mxGeometry>
        </mxCell>

        <!-- CONVERGENCE BOX -->
        <mxCell id="19" value="&lt;b&gt;CONVERGENCE — Global Min-Max Normalization&lt;/b&gt;&lt;hr&gt;Normalisasi pixel-level dari 83 test maps:&lt;br&gt;map_norm = (map - min_all) / (max_all - min_all)&lt;br&gt;&lt;i&gt;Konsisten dengan batch experiment&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EEF8;strokeColor=#8E44AD;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="1090" width="340" height="65" as="geometry" />
        </mxCell>

        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="19" target="20">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <!-- ========== THRESHOLD ========== -->
        <mxCell id="20" value="&lt;b&gt;THRESHOLD — Percentile 95% dari Training Data&lt;/b&gt;&lt;hr&gt;PaDiM &amp;gt;= 0.471 &amp;nbsp; : &amp;nbsp; &lt;b&gt;ANOMALY&lt;/b&gt; (score tinggi)&lt;br&gt;PaDiM &amp;lt; 0.471 &amp;nbsp; : &amp;nbsp; &lt;b&gt;NORMAL&lt;/b&gt; (score rendah)&lt;br&gt;KNN &amp;gt;= 1.471 &amp;nbsp; : &amp;nbsp; &lt;b&gt;ANOMALY&lt;/b&gt;&lt;br&gt;KNN &amp;lt; 1.471 &amp;nbsp; : &amp;nbsp; &lt;b&gt;NORMAL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="1185" width="340" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="20" target="21">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

        <!-- ========== OUTPUT ========== -->
        <mxCell id="21" value="&lt;b&gt;OUTPUT — HASIL DETEKSI&lt;/b&gt;&lt;hr&gt;Image Score &amp;emsp;|&amp;emsp; Predicted Label &amp;emsp;|&amp;emsp; Anomaly Map&amp;emsp;|&amp;emsp; Inference Time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#27AE60;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="1310" width="300" height="55" as="geometry" />
