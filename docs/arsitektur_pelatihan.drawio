          </mxGeometry>
        </mxCell>

        <mxCell id="17b" value="&lt;b&gt;2. compute_cov_inv() — Kovarians + Invers&lt;/b&gt;&lt;hr&gt;Per posisi: covariance [550,550] + inverse + reg epsilon=0.01&lt;br&gt;hasil: &lt;b&gt;cov_inv [550, 550, 3136]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#8E44AD;fontSize=11;" vertex="1" parent="1">
