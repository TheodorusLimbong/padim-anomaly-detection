        </mxCell>

        <mxCell id="18b" value="&lt;b&gt;2. Siap untuk Inference KNN&lt;/b&gt;&lt;hr&gt;Setiap test patch dibandingkan via Euclidean&lt;br&gt;dengan bank ini, ambil top-5 closest, rata-rata&lt;br&gt;&lt;i&gt;compute_knn_anomaly_score() chunked (22 chunks)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E6F1;strokeColor=#2E86C1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="940" y="440" width="460" height="60" as="geometry" />
