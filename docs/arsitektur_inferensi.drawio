        <mxCell id="el20" parent="e20" value="&lt;i&gt;label: ANOMALY / NORMAL&lt;/i&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#888;" vertex="1" connectable="0" ><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
      
        <mxCell id="el16l" parent="e16l" value="&lt;i&gt;patch [3136,550]&lt;/i&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#8E44AD;" vertex="1" connectable="0" ><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
