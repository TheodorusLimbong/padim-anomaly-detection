        <mxCell id="el17b_int" parent="e17b" value="&lt;i&gt;blurred [56, 56]&lt;/i&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#8E44AD;" vertex="1" connectable="0" ><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
